{
  "name": "judien",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "npx kill-port 4000 && pnpm --filter @judien/api dev",
    "dev:web": "pnpm --filter @judien/web dev",
    "dev:mobile": "pnpm --filter @judien/mobile start",
    "build:all": "pnpm --filter @judien/shared build && pnpm --filter @judien/api build && pnpm --filter @judien/web build",
    "db:generate": "pnpm --filter @judien/api prisma:generate",
    "db:migrate": "pnpm --filter @judien/api prisma:migrate",
    "db:studio": "pnpm --filter @judien/api prisma:studio",
    "queue:worker": "pnpm --filter @judien/api worker",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "push": "git add . && git commit -m \"update\" && git push && pnpm --filter @judien/mobile update \"update\"",
    "mobile": "pnpm --filter @judien/mobile build",
    "mobile:ios": "pnpm --filter @judien/mobile build:ios",
    "mobile:android": "pnpm --filter @judien/mobile build:android",
    "mobile:submit": "pnpm --filter @judien/mobile submit",
    "mobile:submit:ios": "cd apps/mobile && eas submit --platform ios",
    "mobile:submit:android": "cd apps/mobile && eas submit --platform android",
    "save": "git add . && git commit -m"
  },
  "pnpm": {
    "overrides": {}
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "kill-port": "^2.0.1",
    "next": "^14.2.4",
    "typescript": "^5.4.5"
  }
}
