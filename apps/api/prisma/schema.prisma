// Prisma schema for Judien MVP
// Run: pnpm db:migrate  (from monorepo root)

generator client {
  provider = "prisma-client-js"
  output   = "../src/__generated__/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum RSVPStatus {
  GOING
  NO
}

enum MessageChannel {
  EMAIL
  LINE
}

enum MessageStatus {
  PENDING
  SENT
  FAILED
}

enum GroupMembershipRole {
  GROUP_ADMIN
  GROUP_MEMBER
}

enum GroupMembershipStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum GroupJoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  JOIN_REQUEST_RECEIVED
  JOIN_REQUEST_APPROVED
  JOIN_REQUEST_REJECTED
  EVENT_REMINDER
  EVENT_INVITE
  GROUP_INVITE_RECEIVED
  NEWS_PUBLISHED
  NEW_EVENT
  EVENT_BLAST
  MEMBER_ADDED
  MEMBER_REMOVED
  ROLE_CHANGED
  EVENT_UPDATED
  EVENT_CANCELLED
  COMMENT_ON_EVENT
  INVITE_ACCEPTED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String        @id @default(cuid())
  email              String?       @unique
  passwordHash       String
  phoneE164          String?       @unique
  displayName        String?
  photoUrl           String?
  preferredLanguage  String        @default("en")  // 'en' | 'zh'
  colorTheme         String        @default("light") // 'light' | 'dark'
  role               Role          @default(USER)
  muteEmail          Boolean       @default(false)
  muteLinePush       Boolean       @default(false)
  muteInAppNotifications Boolean   @default(false)
  lineUserId         String?       @unique
  appleUserId        String?       @unique
  isGuest            Boolean       @default(false)
  hasPassword        Boolean       @default(false)
  createdAt          DateTime      @default(now())

  events        Event[]
  rsvps         RSVP[]
  comments      Comment[]
  messageLogs   MessageLog[]
  groupMessages GroupMessage[]
  news          News[]
  createdGroups Group[]            @relation("GroupCreatedBy")
  groupMemberships GroupMembership[] @relation("GroupMember")
  groupMembershipInvites GroupMembership[] @relation("GroupMembershipInvitedBy")
  groupInvitesSent GroupInvite[]   @relation("GroupInviteSentBy")
  groupInvitesReceived GroupInvite[] @relation("GroupInviteUser")
  groupJoinRequests GroupJoinRequest[] @relation("GroupJoinRequestRequester")
  reviewedJoinRequests GroupJoinRequest[] @relation("GroupJoinRequestReviewer")
  eventInvitesCreated EventInvite[] @relation("EventInviteCreatedBy")
  eventInvitesAccepted EventInvite[] @relation("EventInviteAcceptedBy")
  eventSeriesCreated EventSeries[] @relation("EventSeriesCreatedBy")
  eventShareLinks EventShareLink[]

  donationRecordsFor     DonationRecord[] @relation("DonationForUser")
  donationRecordsCreated DonationRecord[] @relation("DonationCreatedBy")

  inviteTokensCreated InviteToken[] @relation("InviteTokenCreatedBy")
  inviteTokensUsed    InviteToken[] @relation("InviteTokenUsedBy")

  notifications       Notification[]

  groupRelationshipRequestsMade     GroupRelationshipRequest[] @relation("GroupRelationshipRequestRequester")
  groupRelationshipRequestsReviewed GroupRelationshipRequest[] @relation("GroupRelationshipRequestReviewer")

  @@index([email])
  @@index([role])
}

model Event {
  id            String   @id @default(cuid())
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id])
  seriesId      String?
  series        EventSeries? @relation(fields: [seriesId], references: [id])
  partNumber    Int?

  coverImageUrl String?

  title         String
  description   String   @default("")
  location      String   @default("")

  startAt       DateTime
  endAt         DateTime?
  timezone      String    @default("Asia/Taipei")

  feeAmount     Decimal?  @db.Decimal(10, 2)
  feeCurrency   String    @default("TWD")

  commentsEnabled  Boolean @default(true)
  messagingEnabled Boolean @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rsvps         RSVP[]
  guestRsvps    GuestRSVP[]
  rsvpPlusOnes  RSVPPlusOne[]
  comments      Comment[]
  reminderRules ReminderRule[]
  messageLogs   MessageLog[]
  invites       EventInvite[]
  shareLink     EventShareLink?

  @@index([startAt])
  @@index([createdById])
  @@index([groupId])
  @@index([seriesId])
}

model EventShareLink {
  id          String   @id @default(cuid())
  eventId     String   @unique
  token       String   @unique
  createdById String
  createdAt   DateTime @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy  User  @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([createdById])
}

model GuestRSVP {
  id           String     @id @default(cuid())
  eventId      String
  guestName    String
  guestEmail   String
  guestPhone   String
  identityHash String
  status       RSVPStatus
  ipAddress    String?
  userAgent    String?
  updatedAt    DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, identityHash])
  @@index([eventId])
}

model EventSeries {
  id          String   @id @default(cuid())
  title       String
  groupId     String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User   @relation("EventSeriesCreatedBy", fields: [createdById], references: [id])
  group     Group? @relation(fields: [groupId], references: [id])
  events    Event[]

  @@index([createdById])
  @@index([groupId])
}

model EventInvite {
  id               String    @id @default(cuid())
  eventId          String
  token            String    @unique
  expiresAt        DateTime
  createdById      String
  acceptedByUserId String?
  acceptedAt       DateTime?
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  createdAt        DateTime  @default(now())

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy  User  @relation("EventInviteCreatedBy", fields: [createdById], references: [id])
  acceptedBy User? @relation("EventInviteAcceptedBy", fields: [acceptedByUserId], references: [id])

  @@index([eventId])
  @@index([token])
}

model RSVP {
  id            String     @id @default(cuid())
  eventId       String
  userId        String
  status        RSVPStatus
  declineReason String?
  updatedAt     DateTime   @updatedAt

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  plusOnes RSVPPlusOne[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model RSVPPlusOne {
  id           String   @id @default(cuid())
  rsvpId       String?
  eventId      String
  name         String
  email        String?
  phone        String?
  relationship String?
  notes        String?
  createdAt    DateTime @default(now())

  rsvp  RSVP?  @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([rsvpId])
  @@index([eventId])
}

model Comment {
  id        String    @id @default(cuid())
  eventId   String
  userId    String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  replyToId String?

  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   Comment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  @@index([eventId, createdAt])
  @@index([replyToId])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@index([userId])
}

model ReminderRule {
  id            String   @id @default(cuid())
  eventId       String
  offsetMinutes Int      // e.g. 1440 = 24h before
  channels      Json     // string[] e.g. ["EMAIL","LINE"]
  enabled       Boolean  @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, offsetMinutes])
  @@index([eventId])
}

model MessageLog {
  id                String        @id @default(cuid())
  eventId           String?
  userId            String
  channel           MessageChannel
  toAddress         String
  payload           Json
  status            MessageStatus @default(PENDING)
  providerMessageId String?
  createdAt         DateTime      @default(now())

  event Event? @relation(fields: [eventId], references: [id])
  user  User   @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model News {
  id            String   @id @default(cuid())
  groupId       String?
  group         Group?   @relation(fields: [groupId], references: [id])
  title         String   @default("")
  body          String   @default("")
  coverImageUrl String?
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([groupId])
}

model Group {
  id                 String            @id @default(cuid())
  pid                String            @unique
  name               String
  description        String            @default("")
  photoUrl           String?
  discoverableBySearch Boolean         @default(true)
  parentGroupId      String?
  createdById        String
  createdBy          User              @relation("GroupCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  parentGroup        Group?            @relation("GroupSubgroups", fields: [parentGroupId], references: [id])
  subgroups          Group[]           @relation("GroupSubgroups")
  memberships        GroupMembership[]
  invites            GroupInvite[]
  joinRequests       GroupJoinRequest[]
  messages           GroupMessage[]
  events             Event[]
  news               News[]
  eventSeries        EventSeries[]

  donationRecords    DonationRecord[]

  notifications      Notification[]

  sentRelationshipRequests     GroupRelationshipRequest[] @relation("GroupRelationshipRequestSource")
  receivedRelationshipRequests GroupRelationshipRequest[] @relation("GroupRelationshipRequestTarget")

  @@unique([name])
  @@index([discoverableBySearch])
  @@index([parentGroupId])
}

model GroupMembership {
  id                     String                @id @default(cuid())
  groupId                String
  userId                 String
  role                   GroupMembershipRole   @default(GROUP_MEMBER)
  status                 GroupMembershipStatus @default(PENDING)
  invitedByPlatformAdminId String?
  invitedByPlatformAdmin User?                 @relation("GroupMembershipInvitedBy", fields: [invitedByPlatformAdminId], references: [id])
  groupNickname          String?
  joinedAt               DateTime?
  sortOrder              Int                   @default(0)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId, status])
}

model GroupInvite {
  id                      String          @id @default(cuid())
  groupId                 String
  invitedByPlatformAdminId String
  invitedByPlatformAdmin  User            @relation("GroupInviteSentBy", fields: [invitedByPlatformAdminId], references: [id])
  invitedUserId           String?
  invitedUser             User?           @relation("GroupInviteUser", fields: [invitedUserId], references: [id])
  email                   String?
  phoneE164               String?
  token                   String          @unique
  expiresAt               DateTime
  status                  GroupInviteStatus @default(PENDING)
  respondedAt             DateTime?
  createdAt               DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([invitedUserId, status])
  @@index([email, status])
}

model GroupJoinRequest {
  id               String                 @id @default(cuid())
  groupId          String
  requesterUserId  String
  note             String                 @default("")
  status           GroupJoinRequestStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  group        Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  requester    User  @relation("GroupJoinRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  reviewedBy   User? @relation("GroupJoinRequestReviewer", fields: [reviewedByUserId], references: [id])

  @@unique([groupId, requesterUserId])
  @@index([groupId, status])
  @@index([requesterUserId, status])
}

model GroupRelationshipRequest {
  id               String   @id
  sourceGroupId    String
  targetGroupId    String
  requesterUserId  String
  status           String   @default("PENDING")
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sourceGroup Group @relation("GroupRelationshipRequestSource", fields: [sourceGroupId], references: [id], onDelete: Cascade)
  targetGroup Group @relation("GroupRelationshipRequestTarget", fields: [targetGroupId], references: [id], onDelete: Cascade)
  requester   User  @relation("GroupRelationshipRequestRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  reviewer    User? @relation("GroupRelationshipRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([sourceGroupId, status])
  @@index([targetGroupId, status])
  @@index([requesterUserId, status])
}

model DonationRecord {
  id          String   @id @default(cuid())
  groupId     String
  forUserId   String
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   // 'USD' or 'NTD'
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  forUser   User  @relation("DonationForUser", fields: [forUserId], references: [id], onDelete: Cascade)
  createdBy User  @relation("DonationCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([forUserId])
}

model InviteToken {
  id          String    @id @default(cuid())
  token       String    @unique
  role        Role      @default(USER)
  createdById String
  createdBy   User      @relation("InviteTokenCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedById    String?
  usedBy      User?     @relation("InviteTokenUsedBy", fields: [usedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([createdById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @default("")
  read      Boolean          @default(false)
  actionUrl String?
  groupId   String?
  eventId   String?
  requestId String?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([userId, read])
  @@index([userId, createdAt])
}
