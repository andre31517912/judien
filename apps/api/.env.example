# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/judien

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
# Access tokens expire in 15 minutes; refresh tokens expire in 30 days (set in auth.service.ts)

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Messaging ───────────────────────────────────────────────────────────────
# Set MOCK_MODE=true for local dev to log messages instead of sending them
MOCK_MODE=true

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at https://resend.com — free up to 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Judien <noreply@yourdomain.com>   # must be a verified domain in Resend dashboard

# ── SMS ───────────────────────────────────────────────────────────────────────
# Set SMS_PROVIDER to enable SMS.  Leave blank to skip SMS (no crash).
# Options: twilio | every8d
SMS_PROVIDER=

# Twilio (SMS_PROVIDER=twilio)
# Sign up at https://twilio.com — works globally including Taiwan (+886)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890   # must be a Twilio number

# Every8d — 每日互動 (SMS_PROVIDER=every8d)
# Sign up at https://www.every8d.com — cheapest for Taiwan local numbers (~NT$0.15/msg)
# EVERY8D_USER_ID=your_user_id
# EVERY8D_PASSWORD=your_password

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
