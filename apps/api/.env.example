# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/judien

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_in_production
# Access tokens expire in 15 minutes; refresh tokens expire in 30 days (set in auth.service.ts)

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── Messaging ───────────────────────────────────────────────────────────────
# Set MOCK_MODE=true for local dev to log messages instead of sending them
MOCK_MODE=true

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890   # must be a Twilio number

# SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=hello@yourdomain.com
SENDGRID_FROM_NAME=Judien

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
