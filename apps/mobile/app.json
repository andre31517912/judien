{
  "expo": {
    "name": "Judien",
    "slug": "judien",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "scheme": "judien",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "privacyManifests": {
              "NSPrivacyAccessedAPITypes": [
                {
                  "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
                  "NSPrivacyAccessedAPITypeReasons": [
                    "CA92.1"
                  ]
                }
              ]
            }
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/55ad33cf-aacb-445f-9aed-2b7b1f88f2d2"
    },
    "newArchEnabled": false,
    "android": {
      "package": "com.judien.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "notification": {
        "icon": "./assets/notification-icon.png",
        "color": "#4F46E5"
      }
    },
    "ios": {
      "bundleIdentifier": "com.judien.app",
      "buildNumber": "1",
      "icon": "./assets/icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Judien needs access to your photo library to upload profile photos and event images.",
        "NSPhotoLibraryAddUsageDescription": "Judien needs permission to save photos to your library."
      }
    },
    "extra": {
      "eas": {
        "projectId": "55ad33cf-aacb-445f-9aed-2b7b1f88f2d2"
      }
    }
  }
}
